{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["**/.claude-plugin/*.json", ".release-please-manifest.json"],
      "options": {
        "parser": "json-stringify"
      }
    }
  ]
}
